# ==============================================================
# IP-SAKTI Sahayak — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_ENV=development          # development | production
APP_NAME="IP-SAKTI Sahayak"
APP_VERSION="0.1.0"
SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32   # Used for JWT signing
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="IP-SAKTI Sahayak"

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
POSTGRES_USER=ipsakti
POSTGRES_PASSWORD=CHANGEME_strong_db_password
POSTGRES_DB=ipsakti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN — override individual vars if needed
DATABASE_URL=postgresql+asyncpg://ipsakti:CHANGEME_strong_db_password@localhost:5432/ipsakti_db

# Sync DSN for Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://ipsakti:CHANGEME_strong_db_password@localhost:5432/ipsakti_db

# ---------------------------------------------------------------
# AI / LLM (mock in dev — replace with real credentials)
# ---------------------------------------------------------------
# Leave OPENAI_API_KEY blank to use the built-in mock adapter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=mock            # mock | openai | azure_openai

# ---------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------
# CORS
# ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
