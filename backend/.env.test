# Test environment — uses SQLite for isolation (no real DB needed for unit tests)
APP_ENV=test
APP_NAME=IP-SAKTI Sahayak (Test)
APP_VERSION=0.1.0
SECRET_KEY=test_secret_key_minimum_32_characters_long_for_testing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite in-memory DB for fast unit tests
DATABASE_URL=sqlite+aiosqlite:///./test.db
DATABASE_URL_SYNC=sqlite:///./test.db

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false
LOG_LEVEL=WARNING

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
